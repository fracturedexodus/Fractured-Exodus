[gd_resource type="Resource" script_class="MissionTemplate" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/Missions/Core/MissionTemplate.cs" id="1_mission_template"]

[resource]
script = ExtResource("1_mission_template")
MissionId = "outpost_smuggler_exchange"
Title = "Smuggler Exchange"
Description = "Board a collapsing black-market exchange, decide whether to stabilize Veil's wounded safehouse or strip the vault, and leave before patrol evidence-burners sweep the station."
MissionScenePath = "res://black_site_relay.tscn"
LayoutResourcePath = "res://Data/MissionLayouts/outpost_smuggler_exchange_builder.json"
DefaultReturnScenePath = "res://exploration_battle.tscn"
RecommendedOfficerCount = 2
SourceNodeType = "Outpost"
ObjectiveText = "OBJECTIVE: Access Broker Veil's uplink, unseal the vault, secure either the safehouse wounded or the route cache, and choose how your fleet leaves the exchange before patrols converge."
PromptText = "Controls: left click an officer to select, left click a floor tile to move, TAB or 1-2 to switch officers, middle mouse drag or WASD to pan, mouse wheel or +/- to zoom, ESC to abort. Use the broker uplink, vault override, safehouse medbay, and patrol scrubber to unlock your final choice."
PrimaryActionText = "CUT A DEAL"
PrimaryOutcomeId = "deal_cut"
PrimaryOutcomeRequiredFlags = PackedStringArray("smuggler_broker_briefed", "smuggler_survivors_secured")
SecondaryActionText = "SEIZE CONTRABAND"
SecondaryOutcomeId = "contraband_seized"
SecondaryOutcomeRequiredFlags = PackedStringArray("smuggler_vault_unsealed", "smuggler_route_cache_secured", "smuggler_patrol_feed_scrubbed")
DefaultDialogueId = "smuggler_exchange_dialogue"
SpawnDefinitionPaths = PackedStringArray("res://Data/Missions/Spawns/outpost_player_a.tres", "res://Data/Missions/Spawns/outpost_player_b.tres")
InteractionKeys = PackedStringArray("outpost:smuggler_exchange")
IsEnabled = true

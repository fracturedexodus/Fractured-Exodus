[ext_resource type="Script" path="res://Scripts/Missions/Props/PropDefinition.cs" id="1_prop_definition"]

[resource]
script = ExtResource("1_prop_definition")
PropId = "relay_archive_core"
DisplayName = "Archive Core"
Description = "The relay's surviving archive spindle. Securing it commits the team to preserving data over lives."
InteractionType = 1
ScenePath = "res://Scenes/Missions/Props/LootCrateProp.tscn"
SpriteTexturePath = "res://Assets/Missions/BlackSiteRelay/GeminiSheetSet/props/archive_core.png"
InteractionRange = 1
OneShot = true
HideWhenConsumed = false
BlockedFlags = PackedStringArray("relay_survivor_objective_complete")
SetFlags = PackedStringArray("relay_archive_objective_complete")
StoryImagePath = "res://Assets/Missions/Cutscenes/archive.png"
StoryDescriptionText = "The archive core unlocks in a wash of fractured light. Long-buried relay records spill across your interface: survivor manifests, custodian directives, sealed traffic logs, and fragments of a wider network the fleet was never meant to see. Whatever this black site was hiding, the data is real, and it is far more valuable than salvage."
StoryConfirmButtonText = "Aquire Archive Core"
SuccessMessage = "The archive spindle is stabilized and ready for extraction."
